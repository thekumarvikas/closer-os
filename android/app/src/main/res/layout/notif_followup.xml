<?xml version="1.0" encoding="utf-8"?>
<!-- Follow-up reminder with large text, so reps can read it at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#0E5E57" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/n_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="17sp" android:textStyle="bold" android:textColor="#B45309" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/n_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textColor="#334155" android:layout_marginTop="2dp" android:maxLines="3" android:ellipsize="end" />
</LinearLayout>
